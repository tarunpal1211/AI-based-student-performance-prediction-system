{
  "feature_set": "early",
  "features": [
    "absences",
    "G1",
    "failures",
    "studytime",
    "assignment_rate",
    "assessment_trend"
  ],
  "label_classes": [
    "At-Risk",
    "Needs Improvement",
    "Performing Well"
  ],
  "label_rules": {
    "Performing Well": "G3 >= 14",
    "Needs Improvement": "8 <= G3 <= 13",
    "At-Risk": "G3 < 8"
  }
}