*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Streamlit & frontends
.streamlit/
frontend/dist/

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
